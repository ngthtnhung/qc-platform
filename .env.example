# Sao chép thành .env (KHÔNG commit). Điền giá trị riêng; không có giá trị mặc định.
APP_ENV=dev                 # dev | team
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# >= 32 ký tự ngẫu nhiên:   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
# base64 của đúng 32 byte:  python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# MẤT KHÓA NÀY = MẤT TOÀN BỘ BÍ MẬT TRONG VAULT. Lưu bản sao ở nơi an toàn, ngoài máy chủ.
SECRET_KEK=
COOKIE_SECURE=false         # true khi chạy sau HTTPS (bắt buộc với APP_ENV=team)
PUBLIC_HOST=                # chỉ profile team, ví dụ qc.noi-bo.local
STORAGE_BACKEND=local       # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# AI (tùy chọn, dùng từ Phase 3)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
